OPENAI_API_KEY=
YOUTUBE_API_KEY=
DATABASE_URL=

# Clerk (see src/services/auth.py) - the secret key from your Clerk
# instance's API Keys page (Clerk Dashboard -> Configure -> API Keys),
# NOT the publishable key frontend/.env uses. Required for
# POST /api/brief/generate and GET /api/intelligence/... to accept
# requests at all - see auth.py's module docstring for why.
CLERK_SECRET_KEY=

# Comma-separated origins allowed to present a session to this API -
# should match wherever the frontend is actually served from. Defaults
# to the Vite dev server if unset (see auth.py).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Per-user request caps for the two paid (GPT-4o-calling) routes - see
# src/services/rate_limit.py. Defaults are conservative starting points
# for a demo/early-stage deployment, not a tuned production limit.
BRIEF_RATE_LIMIT_PER_HOUR=20
INTELLIGENCE_RATE_LIMIT_PER_HOUR=60

# Anonymous (demo-link) cap for GET /api/intelligence/... - keyed by
# client IP, which is shared behind NAT and forgeable via
# X-Forwarded-For, so this is a courtesy throttle. What actually bounds
# spend on that route is the response cache below.
DEMO_INTELLIGENCE_RATE_LIMIT_PER_HOUR=30

# How long an aggregated intelligence response is reused before being
# recomputed (one GPT-4o call). Stored patterns only change when the
# offline pipeline runs, so this is the staleness accepted in exchange
# for not paying per request.
INTELLIGENCE_CACHE_TTL_SECONDS=900
