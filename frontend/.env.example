# Copy this file to .env and fill in the real value (see backend/.env.example
# for the backend-side counterpart).

# Clerk (see src/main.jsx) - the publishable key from your Clerk instance's
# API Keys page (Clerk Dashboard -> Configure -> API Keys), NOT the secret
# key backend/.env uses. Vite only exposes VITE_-prefixed vars to browser
# code, hence the prefix. Required for ClerkProvider to initialize at all -
# without it, sign-in/sign-up won't work anywhere in the app.
VITE_CLERK_PUBLISHABLE_KEY=
